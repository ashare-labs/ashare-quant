          "scenario_manifest_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Scenario Manifest Sha256",
            "type": "string"
          },
          "schema_version": {
            "const": "paper-session.v1",
            "default": "paper-session.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "sell_tax_rate": {
            "default": "0.001",
            "maxLength": 40,
