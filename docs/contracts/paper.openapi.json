          "security": {
            "pattern": "^[0-9]{6}\\.(XSHG|XSHE)$",
            "title": "Security",
            "type": "string"
          },
          "source_event": {
            "additionalProperties": true,
            "title": "Source Event",
            "type": "object"
          }
