          "data_manifest_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Data Manifest Sha256",
            "type": "string"
          },
          "deadline": {
            "format": "date-time",
            "title": "Deadline",
            "type": "string"
          },
