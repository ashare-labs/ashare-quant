          },
          "reason": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "expected_parent",
          "day"
        ],
        "title": "AdvanceAction",
        "type": "object"
      },
      "CashDividend": {
        "additionalProperties": false,
