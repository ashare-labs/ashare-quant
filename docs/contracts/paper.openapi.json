          "previous_close",
          "observed_at",
          "complete",
          "source_watermark",
          "selected_watermark",
          "eligible",
          "suspended",
          "is_st",
          "lower_limit",
          "upper_limit",
          "rule_version",
          "actions_known_absent",
          "facts_available_at"
        ],
        "title": "DecisionRow",
        "type": "object"
      },
      "ExecutionRow": {
        "additionalProperties": false,
