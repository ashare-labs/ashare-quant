            "properties": {
              "end": {
                "format": "date-time",
                "title": "End",
                "type": "string"
              },
              "security": {
                "pattern": "^(?:[0-9]{6}\\.(?:XSHG|XSHE)|BJ\\.[0-9]{6})$",
                "title": "Security",
                "type": "string"
              },
              "source": {
                "default": "auto",
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_.-]+$",
                "title": "Source",
                "type": "string"
              },
              "start": {
                "format": "date-time",
                "title": "Start",
                "type": "string"
              }
            },
            "required": [
              "security",
              "start",
              "end"
            ],
            "title": "MinuteSelection",
            "type": "object"
          }
        },
        "properties": {
          "configuration_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Configuration Id",
            "type": "string"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "selection": {
            "$ref": "#/$defs/MinuteSelection"
          }
        },
        "required": [
          "configuration_id",
          "selection"
        ],
        "title": "read_minute_pricesArguments",
        "type": "object"
      },
      "name": "read_minute_prices",
      "outputSchema": {
        "additionalProperties": true,
        "title": "read_minute_pricesDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Page the live factor catalogue, including exact IDs, definitions and input dependencies.\n\n        qlib_alpha158 features and GTJA alpha191:alpha158 are separate namespaces.\n        ",
      "inputSchema": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "environment_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Environment Id",
            "type": "string"
          },
          "library": {
            "anyOf": [
              {
                "enum": [
                  "alpha191",
                  "qlib_alpha158",
                  "joinquant"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Library"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "default": "",
            "maxLength": 100,
            "title": "Query",
            "type": "string"
          },
          "version": {
            "default": "gtja191.explicit.v1",
            "enum": [
              "gtja191.explicit.v1",
              "gtja191.public.v1"
            ],
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "environment_id"
        ],
        "title": "discover_factorsArguments",
        "type": "object"
      },
      "name": "discover_factors",
      "outputSchema": {
        "additionalProperties": true,
        "title": "discover_factorsDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List registered sources and their real readiness/bases; select an ID to page its securities.\n\n        Only server-registered IDs are accepted. Source locators are never agent inputs.\n        The owner catalogue may itself report fewer securities than total_securities.\n        ",
      "inputSchema": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "environment_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Environment Id",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "source_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,80}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Id"
          }
        },
        "required": [
          "environment_id"
        ],
        "title": "factor_sourcesArguments",
        "type": "object"
      },
      "name": "factor_sources",
      "outputSchema": {
        "additionalProperties": true,
        "title": "factor_sourcesDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Submit explicitly trusted minute (default 1m) or daily (1d) Python to the shared queue.\n\n        User must explicitly accept trusted_local_code and accept_research_model; never infer them.\n        Securities and history are requested by strategy APIs against the frozen release.\n        Use actual data coverage and the published resource policy; initial cash is at most 100亿元 CNY.\n        Reuse the exact body/key after uncertain outcomes; no Python checkpoint resume.\n        ",
      "inputSchema": {
        "$defs": {
          "JsonValue": {},
          "PythonProject": {
            "additionalProperties": false,
            "properties": {
              "entrypoint": {
                "minLength": 1,
                "title": "Entrypoint",
                "type": "string"
              },
              "files": {
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 1,
                "title": "Files",
                "type": "object"
              },
              "project_id": {
                "pattern": "^aqproj-[0-9a-f]{32}$",
                "title": "Project Id",
                "type": "string"
              }
            },
            "required": [
              "project_id",
              "entrypoint",
              "files"
            ],
            "title": "PythonProject",
            "type": "object"
          },
          "StrategySubmission": {
            "additionalProperties": false,
            "description": "Consent fields remain required Literal[True]; never inferred by this adapter.",
            "properties": {
              "accept_research_model": {
                "const": true,
                "title": "Accept Research Model",
                "type": "boolean"
              },
              "end_date": {
                "format": "date",
                "title": "End Date",
                "type": "string"
              },
              "environment_id": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Environment Id",
                "type": "string"
              },
              "frequency": {
                "default": "1m",
                "enum": [
                  "1m",
                  "1d"
                ],
                "title": "Frequency",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 96,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Idempotency Key",
                "type": "string"
              },
              "initial_cash": {
                "default": 100000,
                "exclusiveMinimum": 0,
                "maximum": 10000000000,
                "title": "Initial Cash",
                "type": "number"
              },
              "name": {
                "maxLength": 80,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "parameters": {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "title": "Parameters",
                "type": "object"
              },
              "project": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PythonProject"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "securities": {
                "default": [],
                "items": {
                  "pattern": "^[0-9]{6}\\.(XSHG|XSHE)$",
                  "type": "string"
                },
                "title": "Securities",
                "type": "array"
              },
              "source": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Source"
              },
              "start_date": {
                "format": "date",
                "title": "Start Date",
                "type": "string"
              },
              "strategy_id": {
                "anyOf": [
                  {
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Strategy Id"
              },
              "trusted_local_code": {
                "const": true,
                "title": "Trusted Local Code",
                "type": "boolean"
              },
              "warmup_sessions": {
                "default": 20,
                "minimum": 0,
                "title": "Warmup Sessions",
                "type": "integer"
              }
            },
            "required": [
              "environment_id",
              "name",
              "idempotency_key",
              "start_date",
              "end_date",
              "accept_research_model",
              "trusted_local_code"
            ],
            "title": "StrategySubmission",
            "type": "object"
          }
        },
        "properties": {
          "submission": {
            "$ref": "#/$defs/StrategySubmission"
          }
        },
        "required": [
          "submission"
        ],
        "title": "submit_strategyArguments",
        "type": "object"
      },
      "name": "submit_strategy",
      "outputSchema": {
        "additionalProperties": true,
        "title": "submit_strategyDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Freeze a registered factor input and submit calculation with optional Alphalens evaluation.\n\n        Numerical definitions and evaluation are owned by the existing backend. No expressions,\n        paths or source edits are accepted. Use the catalogue definition/environment exactly.\n        Evaluation labels need observed prices through label_end; missing data stays missing.\n        ",
      "inputSchema": {
        "$defs": {
          "EvaluationOptions": {
            "additionalProperties": false,
            "properties": {
              "cost_bps": {
                "default": [
                  0,
                  5,
                  10,
                  20
                ],
                "items": {
                  "type": "number"
                },
                "title": "Cost Bps",
                "type": "array"
              },
              "direction": {
                "default": 1,
                "enum": [
                  -1,
                  1
                ],
                "title": "Direction",
                "type": "integer"
              },
              "horizons": {
                "default": [
                  1,
                  5,
                  10
                ],
                "items": {
                  "type": "integer"
                },
                "title": "Horizons",
                "type": "array"
              },
              "lag": {
                "default": 1,
                "maximum": 252,
                "minimum": 1,
                "title": "Lag",
                "type": "integer"
              },
              "min_assets": {
                "default": 5,
                "minimum": 2,
                "title": "Min Assets",
                "type": "integer"
              },
              "quantiles": {
                "default": 5,
                "maximum": 20,
                "minimum": 2,
                "title": "Quantiles",
                "type": "integer"
              },
              "rolling_window": {
                "default": 20,
                "maximum": 2520,
                "minimum": 2,
                "title": "Rolling Window",
                "type": "integer"
              }
            },
            "title": "EvaluationOptions",
            "type": "object"
          },
          "FactorSubmission": {
            "additionalProperties": false,
            "description": "Use the backend's bounded, closed request without accepting source paths.",
            "properties": {
              "definition": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Definition",
                "type": "string"
              },
              "end_date": {
                "format": "date",
                "title": "End Date",
                "type": "string"
              },
              "environment_id": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Environment Id",
                "type": "string"
              },
              "evaluation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EvaluationOptions"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "factor_id": {
                "pattern": "^(joinquant|alpha191|qlib_alpha158):[A-Za-z0-9_]+$",
                "title": "Factor Id",
                "type": "string"
              },
              "history_start": {
                "format": "date",
                "title": "History Start",
                "type": "string"
              },
              "idempotency_key": {
                "maxLength": 96,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Idempotency Key",
                "type": "string"
              },
              "label_end": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Label End"
              },
              "name": {
                "maxLength": 80,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "parameters": {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "title": "Parameters",
                "type": "object"
              },
              "rank_policy": {
                "default": "strict",
                "enum": [
                  "strict",
                  "available"
                ],
                "title": "Rank Policy",
                "type": "string"
              },
              "securities": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "title": "Securities",
                "type": "array"
              },
              "source_id": {
                "pattern": "^[A-Za-z0-9_-]{1,80}$",
                "title": "Source Id",
                "type": "string"
              },
              "start_date": {
                "format": "date",
                "title": "Start Date",
                "type": "string"
              }
            },
            "required": [
              "environment_id",
              "idempotency_key",
              "name",
              "factor_id",
              "definition",
              "source_id",
              "securities",
              "history_start",
              "start_date",
              "end_date"
            ],
            "title": "FactorSubmission",
            "type": "object"
          },
          "JsonValue": {}
        },
        "properties": {
          "submission": {
            "$ref": "#/$defs/FactorSubmission"
          }
        },
        "required": [
          "submission"
        ],
        "title": "submit_factorArguments",
        "type": "object"
      },
      "name": "submit_factor",
      "outputSchema": {
        "additionalProperties": true,
        "title": "submit_factorDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Recover a lost submission response using its original idempotency key.",
