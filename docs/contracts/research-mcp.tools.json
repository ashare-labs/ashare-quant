{
  "schema": "research-mcp.tools.v1",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Discover real backend availability, environment identities and research limits.",
