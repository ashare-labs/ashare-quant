      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Check coverage and fetch a bounded daily price page; gaps never become invented prices.",
      "inputSchema": {
        "$defs": {
          "DailySelection": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "format": "date",
                "title": "End",
                "type": "string"
              },
              "reference_set": {
                "anyOf": [
                  {
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reference Set"
              },
              "securities": {
                "items": {
                  "pattern": "^(?:[0-9]{6}\\.(?:XSHG|XSHE)|BJ\\.[0-9]{6})$",
                  "type": "string"
                },
                "minItems": 1,
                "title": "Securities",
                "type": "array"
              },
              "source": {
                "default": "auto",
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_.-]+$",
                "title": "Source",
                "type": "string"
              },
              "start": {
                "format": "date",
                "title": "Start",
                "type": "string"
              }
            },
            "required": [
              "securities",
              "start",
              "end"
            ],
            "title": "DailySelection",
            "type": "object"
          }
        },
        "properties": {
          "configuration_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Configuration Id",
            "type": "string"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "selection": {
            "$ref": "#/$defs/DailySelection"
          }
        },
        "required": [
          "configuration_id",
          "selection"
        ],
        "title": "inspect_dataArguments",
        "type": "object"
      },
      "name": "inspect_data",
      "outputSchema": {
        "additionalProperties": true,
        "title": "inspect_dataDictOutput",
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read published minute observations in pages; at most one security and three days.",
      "inputSchema": {
        "$defs": {
          "MinuteSelection": {
