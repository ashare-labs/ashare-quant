          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "query": {
            "default": "",
            "maxLength": 100,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "configuration_id"
        ],
        "title": "discover_dataArguments",
        "type": "object"
      },
      "name": "discover_data",
      "outputSchema": {
        "additionalProperties": true,
        "title": "discover_dataDictOutput",
