    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search the configured published instrument catalogue and list minute data sources.",
      "inputSchema": {
        "properties": {
          "configuration_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Configuration Id",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
